PORT=5000
CLIENT_URL=http://localhost:5173

HF_API_KEY=
HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct:featherless-ai

# Optional — sensible defaults apply if left unset.
# General: applies to every request (basic abuse protection).
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=900000
# Generate: much stricter, since this is the endpoint that costs money (AI + vision calls).
RATE_LIMIT_GENERATE_MAX=10
RATE_LIMIT_GENERATE_WINDOW_MS=900000
